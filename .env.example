# ==============================================================================
# Smart Object Detection and AI Image Description System
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your real credentials if you wish to use
# cloud vision-language models. The application will function 100% locally
# with YOLOv8n object detection and heuristic scene synthesis if no API keys are provided.
# ==============================================================================

# Preferred AI Provider: 'azure', 'openai', 'gemini', or 'local'
DEFAULT_AI_PROVIDER=local

# ------------------------------------------------------------------------------
# 1. Azure AI Foundry (Azure OpenAI / Serverless Model Endpoints)
# ------------------------------------------------------------------------------
# Examples:
# - Azure OpenAI: https://<your-resource-name>.openai.azure.com/openai/deployments/<deployment-name>/chat/completions?api-version=2024-02-15-preview
# - Serverless / Foundry: https://<endpoint-name>.services.ai.azure.com/models/chat/completions
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
AZURE_AI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 2. OpenAI API (Vision models: gpt-4o, gpt-4o-mini)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. Google Gemini API (Vision models: gemini-1.5-flash, gemini-1.5-pro)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Application Tuning Defaults
# ------------------------------------------------------------------------------
DEFAULT_CONFIDENCE_THRESHOLD=0.30
DEFAULT_IOU_THRESHOLD=0.45
MAX_IMAGE_SIZE_MB=15
